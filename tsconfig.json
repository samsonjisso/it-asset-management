{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
, "src/app/(app)/devices/.DeviceRegistrationPage.tsx", "src/app/(app)/devices/.page.tsx", "src/app/(app)/device-types/.DeviceTypesPage.tsx", "src/app/(app)/device-types/.page.tsx", "src/app/(app)/server-environments/.ServerEnvironmentsPage.tsx"  ],
  "exclude": [
    "node_modules",
    "server"
  ]
}
