# Copy this file to server/.env and adjust as needed.

# Port the Express API listens on.
PORT=4000

# Secret used to sign login sessions (JWTs). Change this to a long
# random string before deploying to production.
JWT_SECRET=change-this-to-a-long-random-string

# MariaDB Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gbb_inventory

# Default administrator account created automatically the first time
# the server starts (only if no admin with this email exists yet).
SEED_ADMIN_EMAIL=admin@gohbetochbank.com
SEED_ADMIN_PASSWORD=Admin@123

# --- Reminder email alerts -------------------------------------------
# Optional. If left unset, reminder emails are logged to the server
# console instead of actually being sent (useful for local testing).
# Configure all four SMTP_* values below to enable real email delivery.

# SMTP server host, e.g. smtp.gmail.com, smtp.office365.com, or your
# organization's mail relay.
# SMTP_HOST=smtp.gmail.com

# SMTP port. Common values: 587 (STARTTLS) or 465 (SSL).
# SMTP_PORT=587

# Set to "true" only if using port 465 (implicit SSL). Leave unset/false
# for port 587 (STARTTLS, most common).
# SMTP_SECURE=false

# SMTP account credentials. For Gmail/Google Workspace, use an "App
# Password" rather than the account's normal login password.
# SMTP_USER=your-alerts-account@example.com
# SMTP_PASS=your-smtp-password-or-app-password

# "From" address shown on outgoing emails. Defaults to SMTP_USER if unset.
# SMTP_FROM="GBB IT Asset Inventory <it-alerts@gohbetochbank.com>"

# How often (in milliseconds) the server checks for due reminders that
# need an email sent. Defaults to 60000 (every 1 minute).
# REMINDER_CHECK_INTERVAL_MS=60000
