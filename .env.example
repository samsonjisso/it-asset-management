# ---- MariaDB connection ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gbb_app
DB_PASSWORD=change-me
DB_NAME=gbb_inventory
DB_CONNECTION_LIMIT=10

# ---- Auth ----
# Required in production. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=8h

# ---- Seed / bootstrap admin (used once by db:seed) ----
SEED_ADMIN_EMAIL=admin@gohbetochbank.com
SEED_ADMIN_PASSWORD=Admin@123

# ---- CORS ----
# Comma-separated allowlist. Leave unset for same-origin only (recommended
# since the API and frontend are one Next.js app now).
CORS_ORIGIN=

# ---- Frontend ----
# Only needed if the API is served from a different origin than the
# Next.js app itself. Leave unset to call same-origin /api.
NEXT_PUBLIC_API_URL=

# ---- Mailer (reminder emails) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GBB Asset Inventory <no-reply@gohbetochbank.com>"
