# Copy this file to .env.local and adjust as needed.

# Only needed if the Express API runs on a different host than the
# default http://localhost:4000 (used by next.config.js to build the
# /api/* rewrite target).
# API_PROXY_TARGET=http://localhost:4000

# Only needed if the frontend calls the API on a different origin than
# same-origin /api (bypassing the Next.js rewrite proxy entirely).
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
